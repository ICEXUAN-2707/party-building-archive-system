# Copy to deploy/compose.env on the server. This file contains no application secret.
WEB_IMAGE=party-archive-web:replace-with-reviewed-release-tag
NGINX_IMAGE=nginx:1.28.0-alpine
NGINX_SERVER_NAME=party.example.edu.cn
PARTY_ARCHIVE_ROOT=/srv/party-archive
PRODUCTION_ENV_FILE=/srv/party-archive/secrets/.env.production
TLS_CERT_DIR=/srv/party-archive/secrets/tls
HTTP_BIND_ADDRESS=0.0.0.0
HTTPS_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
